APP_ENV=development
DATABASE_URL=sqlite:///./devforge.db
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=devforge-ai
JWT_AUDIENCE=devforge-ai-api
JWT_ACCESS_TOKEN_MINUTES=30
ALLOW_REGISTRATION=false
WORKSPACE_ROOT=./workspace
# Required to enable authenticated internal worker lease endpoints.
# Generate a unique random secret of at least 32 characters.
WORKER_SHARED_SECRET=
WORKER_LEASE_SECONDS=60
WORKER_MAX_LEASE_SECONDS=300
