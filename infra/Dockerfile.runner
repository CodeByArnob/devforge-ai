FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /srv/devforge
RUN groupadd --system runner && useradd --system --gid runner --home-dir /srv/devforge runner
COPY pyproject.toml ./
COPY runner ./runner
RUN pip install --no-cache-dir .
USER runner
ENTRYPOINT ["python", "-m", "runner.runner_service"]
